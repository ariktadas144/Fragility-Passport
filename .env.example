# Copy this file to backend/.env and adjust as needed.
# Every setting has a working default — nothing here is required for local
# development or a demo. See backend/app/config.py for the source of truth.

# --- Database ---
# Default: a local SQLite file at backend/fragility_passport.db
# For Postgres/Supabase: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./fragility_passport.db

# --- Evidence storage ---
# Where saved frame/clip files live on disk.
EVIDENCE_DIR=./evidence

# --- CORS ---
# JSON array of origins allowed to call this API (your frontend's dev/prod URLs).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Alert auto-escalation ---
# Seconds an unacknowledged HIGH/CRITICAL alert waits before auto-escalating.
ESCALATION_SECONDS=15
# How often the background task checks for stale alerts.
ESCALATION_POLL_INTERVAL_SECONDS=5

# --- Security ---
# If set, write endpoints (POST/PUT) require this value in the X-API-Key
# header. Leave blank for local/demo use.
API_KEY=

# --- Workstream 2's AI assistant integration ---
# Not read by this backend directly — reserved for whichever service wires
# up the real ReasoningClient (see app/services/assistant_service.py).
GEMINI_API_KEY=

# --- Misc ---
APP_NAME=Fragility Passport API
ENVIRONMENT=development
